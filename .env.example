# Copy to .env only when you need overrides. Never commit .env.
APP_URL=http://localhost:3210
BIND_ADDRESS=127.0.0.1
APP_PORT=3210
# Blank: create your password in the first-run UI on a trusted connection.
APP_PASSWORD=
# Blank: generate /data/secret.key automatically. Back this key up with SQLite.
APP_SECRET_KEY=
SEED_DEMO=false
SCHEDULER_SECONDS=600
WALLET_HORIZON_DAYS=30
# Applies to ALL outbound connections, including ntfy and webhooks.
ALLOW_PRIVATE_NETWORK=false
# Optional comma-separated exact hostnames (include api.telegram.org if used).
OUTBOUND_ALLOWED_HOSTS=
# Blank notification variables do not override the UI. Explicit false does.
TELEGRAM_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_ENABLED=
NTFY_SERVER_URL=
NTFY_TOPIC=
NTFY_TOKEN=
